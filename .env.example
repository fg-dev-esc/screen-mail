# Copia este archivo a .env. Reinicia la app después de cambiarlo.
MAIL_USER=
MAIL_APP_PASSWORD=
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Máximo por respuesta; debe caber en la cuota de salida por minuto (OTPM).
GROQ_MAX_COMPLETION_TOKENS=800

# Configuración predeterminada para Gmail. Destinatario = MAIL_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Límite conservador del mensaje completo, incluida codificación MIME.
SMTP_MAX_MB=20
